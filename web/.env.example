# Copy to web/.env for local dev, or set these as the API_BASE_URL / APP_TOKEN
# GitHub secrets for the APK build. Both are baked into the bundle at build time.
#
# Leave VITE_API_BASE_URL empty to run fully offline (no sync, no coach).
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TOKEN=local-dev-token
